DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://app.domain.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_ENV=local
# Public origin for canonical URLs, Open Graph, and sitemap (no trailing slash)
SITE_URL=http://localhost:8000
# Marketing landing origin (no trailing slash)
LANDING_URL=http://localhost:3000

POSTGRES_DB=myautohub
POSTGRES_USER=myautohub
POSTGRES_PASSWORD=myautohub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://myautohub:myautohub@localhost:5432/myautohub

# Set true to use SQLite instead of Postgres (local only, without Docker DB)
USE_SQLITE=false

WEB_PORT=8000
